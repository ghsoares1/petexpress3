# Preencha somente o arquivo .env. Nunca envie esse arquivo para o GitHub.
# Use os valores sem aspas.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# production usa init_point, inclusive com as credenciais APP_USR da conta de teste.
MERCADOPAGO_CHECKOUT_MODE=production
# Endereço HTTPS público do backend para retorno e webhook.
APP_BASE_URL=
PETEXPRESS_FRONTEND_URL=
MERCADOPAGO_WEBHOOK_SECRET=

# Conta Uber Direct aprovada. Preencha após obter acesso na Uber.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
# Dados reais do ponto de coleta
UBER_PICKUP_NAME=
UBER_PICKUP_PHONE=
UBER_PICKUP_STREET=
UBER_PICKUP_CITY=
UBER_PICKUP_STATE=
UBER_PICKUP_CEP=

